# ── Python ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ────────────────────────────────
venv/
env/
.venv/

# ── Environment / secrets ───────────────────────────────
.env

# ── SQLite database (runtime data — regenerated on startup) ──
sentinel.db
sentinel.db-shm
sentinel.db-wal

# ── v4 model artifacts (regenerate with: python train.py) ────
# model_meta.json is intentionally NOT ignored — it is small
# and useful as a reference for what was trained.
models/isolation_forest.pkl
models/scaler.pkl
models/*.tmp.pkl
models/*.tmp.json

# ── v3 legacy model (superseded by models/ artifacts) ──────
dos_model.pkl

# ── Generated evaluation reports ───────────────────────────
reports/

# ── Collected baseline data (machine-specific, generated) ──
data/normal_baseline.csv
real_baseline.csv

# ── OS ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
